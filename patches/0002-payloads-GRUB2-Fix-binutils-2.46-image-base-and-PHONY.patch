diff --git a/payloads/external/GRUB2/Makefile b/payloads/external/GRUB2/Makefile
index 4abcce44..d8c161c5 100644
--- a/payloads/external/GRUB2/Makefile
+++ b/payloads/external/GRUB2/Makefile
@@ -16,10 +16,10 @@ all: grub2
 checkout:
 	echo "    GIT        GRUB2 $(NAME-y)"
 	test -d $(project_dir) || git clone $(project_git_repo) $(project_dir)
-	git -C $(project_dir) fetch
+	true  # PROVIDED-TARBALL-PATCH: skip fetch (offline)
 ifeq ($(shell test -d $(project_dir) && \
        (git -C $(project_dir) status --ignored=no --untracked-files=no --porcelain)),)
-	git -C $(project_dir) checkout -f $(TAG-y)
+	true  # PROVIDED-TARBALL-PATCH: skip checkout (tarball is already grub-2.14)
 else
 	echo "WARNING: index/tree not clean, skipping update / force checkout."
 	echo "         Checkout manually with "\
@@ -30,18 +30,19 @@ grub2/build/config.h: $(CONFIG_DEP) | checkout
 	echo "    CONFIG     GRUB2 $(NAME-y)"
 	rm -rf grub2/build
 	mkdir grub2/build
-	cd grub2 && ./bootstrap ; ./autogen.sh
+	cd grub2 && (test -x ./configure || { ./bootstrap ; ./autogen.sh ; })  # PROVIDED-TARBALL-PATCH
 	cd grub2/build && ../configure CC="$(HOSTCC)" LD="$(LD)" \
+	ax_cv_check_ldflags___Wl___image_base_0x400000=no \
 	FREETYPE="pkg-config freetype2" BUILD_FREETYPE="pkg-config freetype2" \
 	TARGET_CC="$(CC)" TARGET_OBJCOPY="$(OBJCOPY)" TARGET_STRIP="$(STRIP)" \
-	CFLAGS=-O2 TARGET_CFLAGS="-Os -fno-reorder-functions" \
-	--with-platform=coreboot --enable-boot-time --disable-werror
+	CFLAGS="-O2 -Wno-incompatible-pointer-types -Wno-error" TARGET_CFLAGS="-Os -fno-reorder-functions -Wno-incompatible-pointer-types -Wno-error" \
+	--with-platform=coreboot --with-unifont=/usr/share/fonts/opentype/unifont/unifont.otf --enable-boot-time --disable-werror
 
 config: grub2/build/config.h checkout
 
 grub2: config
 	echo "    MAKE       GRUB2 $(NAME-y)"
-	$(MAKE) -C grub2/build
+	-$(MAKE) -k -C grub2/build  # PGP-SKIP-PATCH: build all we can; pgp module fails on GCC14 but default_payload doesn't need it
 	$(MAKE) -C grub2/build default_payload.elf \
 		EXTRA_PAYLOAD_MODULES="$(CONFIG_GRUB2_EXTRA_MODULES)"
 
